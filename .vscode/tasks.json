{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build OpenGL Project (Windows)",
            "command": "g++",
            "args": [
                "-std=c++17",
                "-I${workspaceFolder}/include",
                "-I${workspaceFolder}",
                "src/main.cpp",
                "src/glad.c",
                "-lglfw3",
                "-lopengl32",
                "-lgdi32",
                "-o",
                "simulation.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
